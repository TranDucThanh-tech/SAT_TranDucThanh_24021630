
















































































from pysat.solvers import Glucose3
import math


def SequentialVar(i, j):
    # i is Block_id
    if (i,j) not in temp_var:
        temp_var[(i,j)] = next_id[0]
        next_id[0] += 1
    return temp_var[(i,j)]





def AMO(g, vars, i):
    # i: block id
    n = len(vars)
    if n == 0:
        g.add_clause([])
        
    for j in range (n):
        g.add_clause([-vars[j], SequentialVar(i, j)])
    for j in range (1, n):
        g.add_clause([-SequentialVar(i,j - 1), SequentialVar(i,j)])
    for j in range (1, n):
        g.add_clause([-vars[j], -SequentialVar(i,j - 1), SequentialVar(i, j)])
    for j in range (1, n):
        g.add_clause([-vars[j], -SequentialVar(i, j - 1)])





def Area(vars, weight, number):
    
    start_index = weight * number
    end_index = min(start_index + weight, len(vars))

    return vars[start_index:end_index]





def EncodingAreas(g, area, number_area, n_Areas, weight):
    number_block1 = NumberBlock(number_area, True, weight)
    number_block2 = NumberBlock(number_area, False, weight)
    block1 = area
    block2 = area[::-1]
    if n_Areas == 1:
        AMO(g, block1, number_block1)
    if number_area != 0:
        AMO(g, block1, number_block1)
    if number_area != n_Areas - 1:
        AMO(g, block2, number_block2)





def ConnectAreas(g,  n_vars, area1, area2, weight):    
    number_block1 = NumberBlock(area1, False, weight)
    number_block2 = NumberBlock(area2, True, weight)
    for j in range (1, weight):
        R_var1 = SequentialVar(number_block1, weight - j - 1)
        R_var2 = SequentialVar(number_block2, j - 1)
        g.add_clause([-R_var1, -R_var2])





def SC(g, vars, weight):
    n_var = len(vars)
    n_Areas = math.ceil(len(vars) / weight)

    for number in range(n_Areas):
        area = Area(vars, weight, number)
        EncodingAreas(g, area, number, n_Areas, weight)

    for number in range(n_Areas - 1):
        ConnectAreas(g, n_var, number, number + 1, weight)





def NumberBlock(number_of_area, isFirst, weight):
    number_of_block = 2 * number_of_area
    if isFirst:
        number_of_block -= 1
    return number_of_block





temp_var = {}
next_id  = [1]


def main():

    g = Glucose3()
    global dictionary_id, next_id
    temp_var = {}
    vars = list(range(1, 13))
    next_id = [max(vars) + 1]
    weight = 11
    SC(g, vars, weight)

    #gán 1 số biến true để kiểm tra 
    #g.add_clause([4])
    g.add_clause([12])

    
    result = g.solve()

    print("SAT:", result)

    if result:

        model = g.get_model()
        true_vars = [x for x in model if x > 0]
        print("Biến nhận giá trị 1:")
        print(true_vars)

if __name__ == "__main__":
    main()
